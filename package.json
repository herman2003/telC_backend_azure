{
  "name": "telC_backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "prisma migrate deploy && node -r newrelic dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "prisma migrate deploy && node -r newrelic dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ratchet": "node scripts/check-eslint-ratchet.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integration": "jest --config ./test/jest-integration.json",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:migrate-from-supabase": "node scripts/migrate-supabase-to-neon.mjs",
    "start:testdb": "powershell -ExecutionPolicy Bypass -File ./scripts/start-dev-testdb.ps1",
    "grammar:import": "ts-node -r ./scripts/env-test-first.cjs scripts/import-grammar-from-rep12.ts",
    "grammar:export": "ts-node -r ./scripts/env-test-first.cjs scripts/export-grammar-topics.ts",
    "grammar:build-lessons": "ts-node -r ./scripts/env-test-first.cjs scripts/build-grammar-lessons.ts",
    "grammar:enrich": "ts-node -r ./scripts/env-test-first.cjs scripts/enrich-grammar-lessons.ts",
    "grammar:generate-exercises": "ts-node -r ./scripts/env-test-first.cjs scripts/generate-grammar-exercises.ts",
    "grammar:backfill-exercise-locales": "ts-node -r ./scripts/env-test-first.cjs scripts/backfill-grammar-exercise-locales.ts",
    "vocab:analyze-extract": "ts-node -r ./scripts/env-test-first.cjs scripts/vocab-analyze-extract-modelltest.ts",
    "vocab:import-rep12": "ts-node -r ./scripts/env-test-first.cjs scripts/vocab-import-from-rep12.ts",
    "vocab:import-goethe": "ts-node -r ./scripts/env-test-first.cjs scripts/vocab-import-goethe-dwds.ts",
    "vocab:import-telc": "ts-node -r ./scripts/env-test-first.cjs scripts/vocab-import-telc-beruf.ts",
    "vocab:enrich-pack-senses": "ts-node -r ./scripts/env-test-first.cjs scripts/vocab-enrich-pack-senses.ts",
    "vocab:fill-conjugations": "ts-node -r ./scripts/env-test-first.cjs scripts/vocab-fill-conjugations.ts",
    "vocab:backfill-fr": "ts-node -r ./scripts/env-test-first.cjs scripts/vocab-backfill-fr-meanings.ts",
    "vocab:curate-weekly-pack": "ts-node -r ./scripts/env-test-first.cjs scripts/vocab-curate-weekly-pack.ts",
    "modelltest:import": "node scripts/import-modelltest-v2.mjs",
    "modelltest:verify": "node scripts/verify-modelltest.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "^1.40.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.13",
    "@nestjs/swagger": "^11.4.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.13",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@supabase/supabase-js": "^2.95.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "diff": "^9.0.0",
    "dotenv": "^17.2.4",
    "firebase-admin": "^14.5.0",
    "german-verbs": "^5.4.0",
    "german-verbs-dict": "^3.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "newrelic": "^14.3.7",
    "node-cache": "^5.1.2",
    "p-limit": "^3.1.0",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "redis": "^6.2.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.2",
    "rxjs": "^7.8.1",
    "stripe": "^17.7.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/diff": "^7.0.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.20.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "fast-uri": "3.1.5",
    "js-yaml": "5.2.3",
    "qs": "6.15.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "-integration\\.spec\\.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1",
      "^@google/genai$": "<rootDir>/test/__mocks__/genai.ts"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
