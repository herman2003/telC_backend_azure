meta {
  name: 07a A B1-B2 block does not exist in an A1 exam
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/exams/attempts/{{a1AttemptId}}/blocks/LESEN_SPRACHBAUSTEINE/start
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{a1StudentAccessToken}}
}
assert {
  res.status: eq 400
  res.body.message: eq BLOCK_NOT_IN_EXAM
}

docs {
  A1 has no Sprachbausteine. The block list comes from exam_block_durations for the sitting's level.
}
