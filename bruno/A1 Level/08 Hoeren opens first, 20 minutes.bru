meta {
  name: 08 Hoeren opens first, 20 minutes
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/exams/attempts/{{a1AttemptId}}/blocks/HOEREN/start
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{a1StudentAccessToken}}
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.getStatus() >= 400) {
    throw new Error(
      "HTTP " + res.getStatus() + ": " + JSON.stringify(res.body) +
        (res.getStatus() === 400 ? "  (BLOCK_OUT_OF_ORDER would mean A1's block order is wrong: HOEREN is position 1)" : "")
    );
  }
  const minutes =
    (new Date(res.body.deadlineAt) - new Date(res.body.startedAt)) / 60000;
  if (minutes !== 20) {
    throw new Error("A1 Hoeren must run 20 minutes, got " + minutes);
  }
}

docs {
  At A1 Hören is block 1, not block 2 as at B1/B2 — the order comes from
  exam_block_durations for A1. Starting it first proves that.
}
