meta {
  name: 14 Submit, auto-scored except the letter
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/api/exams/attempts/{{a1AttemptId}}/blocks/LESEN_SCHREIBEN/submit
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{a1StudentAccessToken}}
}

body:json {
  {
    "answers": {
      "LESEN_1": { "1": true, "2": false, "3": false, "4": false, "5": true },
      "LESEN_2": { "6": "b", "7": "a", "8": "a", "9": "b", "10": "b" },
      "LESEN_3": { "11": true, "12": false, "13": false, "14": true, "15": true },
      "SCHREIBEN_1": {
        "1": 4,
        "2": "2",
        "3": "Seheim",
        "4": "Bar",
        "5": "nächsten Sonntag"
      },
      "SCHREIBEN_2": {
        "text": "Sehr geehrte Damen und Herren, ich komme im August nach Dresden. Bitte schicken Sie mir Informationen über das Kulturprogramm und Hoteladressen. Mit freundlichen Grüßen"
      }
    }
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.getStatus() >= 400) {
    throw new Error("HTTP " + res.getStatus() + ": " + JSON.stringify(res.body));
  }
  const by = {};
  for (const s of res.body.sections) by[s.skill + "_" + s.teil] = s;

  if (by.LESEN_1.score !== 100 || by.LESEN_2.score !== 80 || by.LESEN_3.score !== 100) {
    throw new Error("expected Lesen 100 / 80 / 100, got " +
      [by.LESEN_1.score, by.LESEN_2.score, by.LESEN_3.score].join(" / "));
  }
  // "Seheim" for Seeheim: telc ignores spelling, the key cannot, so the
  // form waits for the examiner rather than losing the point.
  if (by.SCHREIBEN_1.pending !== true) {
    throw new Error("SCHREIBEN_1 should wait for the examiner, got " + JSON.stringify(by.SCHREIBEN_1));
  }
  if (by.SCHREIBEN_2.score !== null || by.SCHREIBEN_2.pending !== true) {
    throw new Error("SCHREIBEN_2 must wait for a person, got " + JSON.stringify(by.SCHREIBEN_2));
  }
}

docs {
  The Lösungsschlüssel, except Lesen item 9 (key: a, sent: b). The form
  sends field 1 as the number 4 (a number field may arrive as one), field 5
  as "nächsten Sonntag", and field 3 misspelt.
}
