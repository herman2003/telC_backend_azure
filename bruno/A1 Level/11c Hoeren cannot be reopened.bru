meta {
  name: 11c Hoeren cannot be reopened
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/api/exams/attempts/{{a1AttemptId}}/blocks/HOEREN/start
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{a1StudentAccessToken}}
}
assert {
  res.status: eq 400
  res.body.message: eq BLOCK_ALREADY_SUBMITTED
}

docs {
  No second attempt at a block already handed in.
}
