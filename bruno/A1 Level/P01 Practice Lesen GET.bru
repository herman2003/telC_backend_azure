meta {
  name: P01 Practice Lesen GET
  type: http
  seq: 100
}

get {
  url: {{baseUrl}}/api/reading/exercise?modelltest=9
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{a1StudentAccessToken}}
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.getStatus() >= 400) {
    throw new Error("HTTP " + res.getStatus() + ": " + JSON.stringify(res.body));
  }
  const body = res.body;
  if (!Array.isArray(body.sections) || body.sections.length !== 3) {
    throw new Error("expected sections[3], got " + JSON.stringify(body.sections));
  }
  if (body.teil1 || body.teil2 || body.teil3) {
    throw new Error("B1 teil1/2/3 must be absent for A1 practice");
  }
  if (!body.sections[0].items || body.sections[0].items[0].solution == null) {
    throw new Error("ADR 0001: Lesen practice must ship solution on items");
  }
  bru.setEnvVar("a1PracticeLesenRevision", body.contentRevision);
  bru.setEnvVar("a1PracticeLesenTeil1Revision", body.sections[0].contentRevision);
}

docs {
  Training (not Exam Day): A1 Lesen on the existing reading route. Needs 01+02.
  Returns generic `sections` with answer keys; no B1 teil1/teil2/teil3.
}
