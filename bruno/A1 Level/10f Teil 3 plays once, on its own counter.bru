meta {
  name: 10f Teil 3 plays once, on its own counter
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/api/exams/attempts/{{a1AttemptId}}/audio/{{a1Teil3AudioId}}/play
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{a1StudentAccessToken}}
}

assert {
  res.status: eq 200
  res.body.playsRemaining: eq 0
}

script:post-response {
  if (res.getStatus() >= 400) {
    throw new Error("HTTP " + res.getStatus() + ": " + JSON.stringify(res.body));
  }
}

docs {
  The third and last recording. After this every Teil has been heard once,
  which is the whole of A1 Hören.
}
