meta {
  name: 02 Put the A1 student on an A1 seat
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/redeem-code
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{a1StudentAccessToken}}
}

body:json {
  {
    "code": "LQ-EETT-WXYZ"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.getStatus() >= 400) {
    throw new Error(
      "HTTP " + res.getStatus() + ": " + JSON.stringify(res.body) +
        (res.getStatus() === 409 ? "  (seat already claimed — re-run scripts/seed-b2-bruno-fixture.mjs)" : "")
    );
  }
}

docs {
  The fixture's A1 seat already carries level A1, so redeeming it makes the
  student A1 and attaches them to the centre — without which they could
  not be admitted to the sitting in 05.
}
