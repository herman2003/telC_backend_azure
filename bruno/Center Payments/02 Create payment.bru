meta {
  name: 02 Create payment
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/payments
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "seats": 10
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("paymentId", res.getBody().id);
  }
}

assert {
  res.status: eq 201
  res.body.status: eq PENDING
  res.body.seats: eq 10
  res.body.unitPriceXaf: eq 4500
  res.body.amountXaf: eq 53100
}

docs {
  Records intent to pay for Start seats. NO MONEY MOVES, nothing granted.

  Profile must be complete (country, city, phone) or this refuses.
  Set a unique `{{idempotencyKey}}` per new payment (uuid).

  10 × 4,500 HT = 45,000 → TTC 53,100 (VAT 18%).

  ## Checks

  1. Send twice unchanged → same `id`, one history row.
  2. Same key, different seats → 409 IDEMPOTENCY_KEY_REUSED.
  3. `paidUntil` / seats unchanged until webhook (`06`).

  Next: `05 Start checkout`, then `06 Simulate provider webhook` (local fake).
}
