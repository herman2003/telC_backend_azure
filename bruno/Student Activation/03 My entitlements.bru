meta {
  name: 03 My entitlements
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/me/entitlements
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentAccessToken}}
}

assert {
  res.status: eq 200
}

docs {
  Student view of Prep Pass / Elena credits on their seat.
  Login as student first if token expired (01 Student login).
}
