meta {
  name: 01b Verify student email
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/verify-email
  body: json
  auth: none
}

body:json {
  {
    "token": "{{verificationToken}}",
    "deviceId": "student-device-1",
    "deviceName": "Bruno"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("studentAccessToken", body.accessToken);
    bru.setEnvVar("studentRefreshToken", body.refreshToken);
    if (body.student && body.student.id) {
      bru.setEnvVar("studentId", body.student.id);
    }
  }
}

assert {
  res.status: eq 201
}

docs {
  Paste the student email token into env `verificationToken`, then Send.
  Do NOT use Center Auth / 02 Verify email — that is for centers only.
}
