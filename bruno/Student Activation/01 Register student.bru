meta {
  name: 01 Register student
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{studentEmail}}",
    "password": "Student-Pass1!",
    "firstName": "Awa",
    "lastName": "Test"
  }
}

assert {
  res.status: eq 201
}

docs {
  Step 1 of student access (the old /api/student-activations route is gone).

  In env `local`, set `studentEmail` to a REAL inbox (Gmail), e.g.
  you+student1@gmail.com — then Send.

  Next: verify email (same as center), then redeem the school code.
}
