meta {
  name: 00 Login student
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{studentEmail}}",
    "password": "Student-Pass1!",
    "deviceId": "student-device-1",
    "deviceName": "Bruno"
  }
}

script:post-response {
  bru.setEnvVar("studentAccessToken", res.body.accessToken);
  bru.setEnvVar("studentRefreshToken", res.body.refreshToken);
}

docs {
  Fresh {{studentAccessToken}} / {{studentRefreshToken}}. Run this whenever a
  request starts failing with 401 mid-session — access tokens expire in 15
  minutes, so anything that takes longer than that must re-run this first.

  Same account and password as Subscription Access / 01 Student login.
}
