meta {
  name: 02 Patch me
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/centers/me
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "countryCode": "CM",
    "cityId": "douala",
    "district": "Akwa"
  }
}

assert {
  res.status: eq 200
}

docs {
  PATCH /api/centers/me updates the SCHOOL only.
  Use: countryCode, cityId (or cityOther), name, district, …
  
  Phone is on the MANAGER: PATCH /api/centers/me/manager
  with { "phone": "+237600000000" }.
  
  Old fields city / centerName / phone on this route → VALIDATION_ERROR.
  
  Each of these must return 400 VALIDATION_ERROR, rejected before the handler
  runs. Try them one at a time:
  
      { "role": "OWNER" }
      { "emailVerified": true }
      { "centerId": "some-other-center" }
      { "id": "some-other-owner" }
      { "email": "attacker@example.com" }
      { "password": "new-password" }
      { "logoUrl": "http://cdn.example.com/x.png" }   non-HTTPS
  
  An empty body `{}` returns 400 NO_PROFILE_FIELDS_SUPPLIED rather than a
  no-op write.
  
  There is no route that names another center. Identity comes from the signed
  token only, which is what makes this endpoint IDOR-resistant by construction.
}
