meta {
  name: 20 A2 student login
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "ngeukeualain+a2student@gmail.com",
    "password": "Student-Pass1!",
    "deviceId": "training-a2-device",
    "deviceName": "Bruno Training"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.getStatus() >= 400) {
    throw new Error("HTTP " + res.getStatus() + ": " + JSON.stringify(res.body));
  }
  bru.setEnvVar("a2StudentAccessToken", res.body.accessToken);
}
