meta {
  name: 10 A1 student login
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "ngeukeualain+a1student@gmail.com",
    "password": "Student-Pass1!",
    "deviceId": "training-a1-device",
    "deviceName": "Bruno Training"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.getStatus() >= 400) {
    throw new Error("HTTP " + res.getStatus() + ": " + JSON.stringify(res.body) +
      "  (re-run scripts/seed-b2-bruno-fixture.mjs)");
  }
  bru.setEnvVar("a1StudentAccessToken", res.body.accessToken);
}
