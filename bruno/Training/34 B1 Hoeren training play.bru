meta {
  name: 34 B1 Hoeren training play
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/api/listening/audio/{{b1TrainingHoerenAudioId}}/play
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{b1StudentAccessToken}}
}

assert {
  res.status: eq 200
  res.body.playsRemaining: eq 1
}

script:post-response {
  if (res.getStatus() >= 400) {
    throw new Error("HTTP " + res.getStatus() + ": " + JSON.stringify(res.body));
  }
  if (!String(res.body.url).startsWith("/api/listening/audio?token=")) {
    throw new Error("expected a signed training stream link, got " + res.body.url);
  }
  bru.setEnvVar("b1TrainingHoerenPlayUrl", res.body.url);
}

docs {
  Needs 33 first (sets b1TrainingHoerenAudioId). Training mint a short-lived
  stream URL; playsRemaining stays the strict-mode hint (1), not a depleting
  counter. Exam Day still refuses a second play — see A1/A2 Level 10a.
}
