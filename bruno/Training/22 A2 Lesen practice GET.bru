meta {
  name: 22 A2 Lesen practice GET
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/api/reading/exercise?modelltest=8
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{a2StudentAccessToken}}
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.getStatus() >= 400) {
    throw new Error("HTTP " + res.getStatus() + ": " + JSON.stringify(res.body));
  }
  const body = res.body;
  if (!Array.isArray(body.sections) || body.sections.length !== 3) {
    throw new Error("A2 Lesen practice expects sections[3]");
  }
  if (body.teil1 || body.teil2 || body.teil3) {
    throw new Error("A2 must not use B1 teil1/teil2/teil3 shape");
  }
  const stim = body.sections[0].material && body.sections[0].material.stimulus &&
    body.sections[0].material.stimulus.imageUrl;
  if (!stim || !String(stim).includes("a2-modelltest-1-lesen-1-directory.png")) {
    throw new Error("A2 Lesen Teil 1 should carry the directory imageUrl");
  }
}
