meta {
  name: 42 B2 redeem seat
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/api/auth/redeem-code
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{studentAccessToken}}
}

body:json {
  {
    "code": "{{activationKey}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.getStatus() >= 400) {
    throw new Error("HTTP " + res.getStatus() + ": " + JSON.stringify(res.body) +
      (res.getStatus() === 409 ? "  (re-run seed-b2-bruno-fixture.mjs)" : ""));
  }
}
