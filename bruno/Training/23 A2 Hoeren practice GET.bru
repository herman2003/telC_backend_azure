meta {
  name: 23 A2 Hoeren practice GET
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/api/listening/exercise?modelltest=8&teil=1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{a2StudentAccessToken}}
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.getStatus() >= 400) {
    throw new Error("HTTP " + res.getStatus() + ": " + JSON.stringify(res.body));
  }
  const body = res.body;
  if (!body.audioId || body.aufgabentyp !== "KURZANTWORT" || !Array.isArray(body.items)) {
    throw new Error("A2 Hören Teil 1 should be KURZANTWORT with audioId+items");
  }
  if (!body.items[0].imageUrl ||
      !String(body.items[0].imageUrl).includes("a2-modelltest-1-hoeren-1-item1-note.png")) {
    throw new Error("A2 Hören practice should carry phone-note imageUrl on items");
  }
}
