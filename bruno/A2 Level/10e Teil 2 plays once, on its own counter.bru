meta {
  name: 10e Teil 2 plays once, on its own counter
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/exams/attempts/{{a2AttemptId}}/audio/{{a2Teil2AudioId}}/play
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{a2StudentAccessToken}}
}

assert {
  res.status: eq 200
  res.body.playsRemaining: eq 0
}

script:post-response {
  if (res.getStatus() >= 400) {
    throw new Error("HTTP " + res.getStatus() + ": " + JSON.stringify(res.body));
  }
  // About twice Teil 2's 304 seconds.
  const seconds = (new Date(res.body.expiresAt) - Date.now()) / 1000;
  if (seconds < 590 || seconds > 610) {
    throw new Error("Teil 2's link should live about 608 s, got " + Math.round(seconds));
  }
}

docs {
  Spending Teil 1 (10) must not have spent Teil 2: each Teil is its own
  recording with its own one play, the way the app plays B1/B2.
}
