meta {
  name: 03 Exam picker offers A2 Modelltest 8
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/centers/me/exam-modelltests
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.getStatus() >= 400) {
    throw new Error(
      "HTTP " + res.getStatus() + ": " + JSON.stringify(res.body) +
        (res.getStatus() === 401 ? "  (re-run Center Auth / 03 Login)" : "")
    );
  }

  const mt8 = res.body.find((m) => m.number === 8);
  if (!mt8) {
    throw new Error(
      "A2 Modelltest 8 is not offered — its exam_sections must cover every " +
        "exam_section_weights row for A2 (GenericExamContentService.isComplete)"
    );
  }
  if (mt8.level !== "A2") {
    throw new Error("the picker must say A2, got " + mt8.level);
  }
}

docs {
  Before Phase 3 Task 6 an A2 paper could never appear here: completeness
  was a fixed check on twelve B1 tables, including Sprachbausteine, which
  A2 does not have.
}
