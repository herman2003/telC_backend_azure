meta {
  name: 01 Log the A2 student in
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "ngeukeualain+a2student@gmail.com",
    "password": "Student-Pass1!",
    "deviceId": "a2-student-device-1",
    "deviceName": "Bruno"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.getStatus() >= 400) {
    throw new Error(
      "HTTP " + res.getStatus() + ": " + JSON.stringify(res.body) +
        "  (re-run node scripts/seed-b2-bruno-fixture.mjs)"
    );
  }
  bru.setEnvVar("a2StudentAccessToken", res.body.accessToken);
  bru.setEnvVar("a2StudentId", res.body.student.id);
}

docs {
  The fixture's A2 student. Email and password are fixed by the fixture, so
  nothing has to be pasted into the environment. Its own deviceId so it
  does not evict the B2 or B1 student's session.
}
