meta {
  name: 15 Progress reflects B2
  type: http
  seq: 31
}

get {
  url: {{baseUrl}}/api/progress/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentAccessToken}}
}

assert {
  res.status: eq 200
}

script:post-response {
  // Status first. Without this an expired access token — they last fifteen
  // minutes — is reported as whatever the body assertion happens to say,
  // which sent somebody hunting for missing content that was never missing.
  if (res.getStatus() >= 400) {
    throw new Error(
      "HTTP " + res.getStatus() + ": " + JSON.stringify(res.body) +
        (res.getStatus() === 401 ? "  (re-run Student Activation / 00 Login student)" : "")
    );
  }

  if (res.body.level !== "B2") {
    throw new Error("progress/me must report the student's level as B2, got " + res.body.level);
  }
}

docs {
  The student redeemed a B2 code in step 02. Their own progress record must
  say B2, not whatever level it defaulted to before activation.
}
