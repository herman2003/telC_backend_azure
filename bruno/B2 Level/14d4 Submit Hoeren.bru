meta {
  name: 14d4 Submit Hoeren
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/api/exams/attempts/{{b2AttemptId}}/blocks/HOEREN/submit
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentAccessToken}}
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.getStatus() >= 400) {
    throw new Error(
      "HTTP " + res.getStatus() + ": " + JSON.stringify(res.body) +
        (res.getStatus() === 401 ? "  (re-run Student Activation / 00 Login student)" : "")
    );
  }
}

docs {
  Closes block 2 so SCHREIBEN may open in 14e.
}
