meta {
  name: 09 Vocab of the week is not empty
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/vocab/of-the-week
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentAccessToken}}
}

assert {
  res.status: eq 200
}

script:post-response {
  const cards = res.body.cards || res.body;
  if (!Array.isArray(cards) || cards.length === 0) {
    throw new Error("the weekly vocab pack is empty — run the extraction for MT 7");
  }
}

docs {
  The pack is built from vocab_occurrences of the weekly paper, which are NOT
  in a migration: they come from running

    npm run vocab:analyze-extract -- --mt=7
    npm run vocab:curate-weekly-pack -- --mt=7

  against the target database. MT 7 has 1514 occurrences and 226 of them in
  the pack.

  Nothing errors when they are missing — the pack just reads empty, which is
  why this request exists.

  Expect no Hoeren vocabulary: the extractor reads it from transcripts, and
  MT 7's are deliberately null until somebody has checked the cut positions.
}
