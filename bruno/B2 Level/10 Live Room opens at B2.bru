meta {
  name: 10 Live Room opens at B2
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/speaking/rooms?level=B2
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentAccessToken}}
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.body.topic.level !== "B2") {
    throw new Error("a B2 room must get a B2 topic, got " + res.body.topic.level);
  }
  if (!String(res.body.topic.id).startsWith("b2-")) {
    throw new Error("topic id should name its level: " + res.body.topic.id);
  }
}

docs {
  THIS WAS A 400 BEFORE THIS PHASE. The level validator accepted only B1, so
  a B2 student could not open a Live Room at all — on a feature Start sells
  as unlimited.

  It must never hand back a B1 topic. A level with no topics of its own is
  refused with NO_TOPICS_FOR_LEVEL instead: try ?level=A1, which has none
  yet, and expect that rather than a 500 or a B1 card.

  Check the route against the mapped list in the boot log if this 404s — the
  rooms controller is under /api/speaking.
}
