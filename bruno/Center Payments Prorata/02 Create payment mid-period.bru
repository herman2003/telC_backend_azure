meta {
  name: 02 Create payment mid-period
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/payments
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "seats": 16
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("paymentId", res.getBody().id);
  }
}

assert {
  res.status: eq 201
  res.body.status: eq PENDING
  res.body.seats: eq 16
  res.body.unitPriceXaf: eq 4500
}

docs {
  Same body as the quote. `amountXaf` must equal quote `totalXaf`.

  Use a **fresh** `idempotencyKey` each run.

  After create: attach fake provider_reference + webhook SUCCEEDED
  (`Center Payments / 06`). Then GET subscription — `paidUntil` unchanged,
  `seatsHeld` = 16.
}
