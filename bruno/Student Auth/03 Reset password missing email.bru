meta {
  name: 03 Reset password missing email
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "123456",
    "newPassword": "Student-Pass1!",
    "deviceId": "student-device-1"
  }
}

assert {
  res.status: eq 400
}

docs {
  Breaking contract check: body without `email` must not be accepted.
}
