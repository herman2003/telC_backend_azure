meta {
  name: 02 Reset password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{studentEmail}}",
    "token": "{{studentResetCode}}",
    "newPassword": "Student-Pass1!",
    "deviceId": "student-device-1",
    "deviceName": "Bruno"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("studentAccessToken", res.body.accessToken);
    bru.setEnvVar("studentRefreshToken", res.body.refreshToken);
  }
}

docs {
  Requires `email` + six-digit `token` (bound lookup). Wrong email+code pair
  returns the same invalid error as an unknown code — no email oracle.
}
