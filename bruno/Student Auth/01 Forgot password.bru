meta {
  name: 01 Forgot password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{studentEmail}}"
  }
}

assert {
  res.status: eq 201
}

docs {
  Always the same success shape. A real account gets a six-digit code by email
  — paste it into env `studentResetCode` before 02.
}
