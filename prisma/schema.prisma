generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum CenterPlan {
  TRIAL
  PAID
}

enum CenterUserRole {
  OWNER
  MANAGER
}

/// What a seat entitles its student to.
///
/// A trial is not a separate plan: it is an ordinary seat priced at zero with a
/// 14-day clock, so trial and paid Start students behave identically
/// everywhere except the clock. That keeps the quota logic to three cases
/// rather than four.
model Student {
  id           String   @id @default(uuid())
  first_name   String?
  last_name    String?
  email        String?  @unique
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt
  last_seen_at DateTime @default(now())

  password_hash              String?
  email_verified             Boolean   @default(false)
  email_verification_token   String?
  email_verification_expires DateTime?
  password_reset_token       String?
  password_reset_expires     DateTime?

  /// WhatsApp number. Optional, and the channel that actually reaches people
  /// in-market — email deliverability is the weaker of the two, which matters
  /// for renewal reminders and for reaching a student whose center lapses.
  phone String?

  /// The center that provisioned this student, and the seat-counting boundary.
  /// Nullable: students who predate the center model, and any future
  /// independent student, simply have none.
  center_id String?

  /// True for a student who was using the app without a school when access
  /// started requiring an activation code (D34).
  ///
  /// Set once, by the migration that introduced the rule, on every row that
  /// had no center and no seat at that moment — so "people already using the
  /// app keep it" means exactly those rows, with no date to configure and no
  /// way for an account created later to fall under it. Nothing writes it
  /// afterwards.
  grandfathered_access Boolean @default(false)

  /// The student's current German level (D38). Declared by the student,
  /// editable by their center. Null until either sets it.
  level CefrLevel?

  center          Center?                  @relation(fields: [center_id], references: [id], onDelete: SetNull)
  ai_usage        AiUsage[]
  device_sessions DeviceSession[]
  exam_sessions   ExamSessionParticipant[]
  exam_attempts   ExamAttempt[]
  notifications   Notification[]
  activities      StudentActivity[]
  training_audio_plays TrainingAudioPlay[]
  writing_attempts         WritingAttempt[]
  listening_attempts       ListeningAttempt[]
  sprachbausteine_attempts SprachbausteineAttempt[]
  lesen_attempts           LesenAttempt[]
  speaking_attempts        SpeakingAttempt[]
  grammar_topic_progress GrammarTopicProgress[]
  grammar_exercise_attempts GrammarExerciseAttempt[]

  @@index([center_id])
  @@index([email])
  @@map("students")
}

model DeviceSession {
  id                 String    @id @default(uuid())
  student_id         String
  device_id          String
  refresh_token_hash String
  device_name        String?
  last_used_at       DateTime  @default(now())
  created_at         DateTime  @default(now())
  revoked_at         DateTime?

  student Student @relation(fields: [student_id], references: [id])

  @@unique([student_id, device_id])
  @@index([student_id])
  @@map("device_sessions")
}

model Center {
  id   String @id @default(uuid())
  /// The only thing registration collects about the center itself, so it stays
  /// required — optional here would let a five-field signup write a row that
  /// says nothing.
  name String

  logo_url String?

  /// Where the school is, as ids rather than prose.
  ///
  /// A controlled country decides the address rules, the currency and later
  /// the tax; free text would give back "Douala / douala / Dla", which no
  /// report can group. Collected during onboarding rather than at
  /// registration, so all of it is nullable until a center completes its
  /// profile.
  country_code String?
  /// Never supplied by a client: it is looked up from the chosen city, so a
  /// city can never end up filed under a region it does not belong to.
  region_id    String?
  /// The city we list, or…
  city_id      String?
  /// …the one we do not. A school in a town missing from the list types it
  /// here and is never blocked from onboarding; a name typed often enough is
  /// promoted into the list, and these rows repointed.
  city_other   String?

  /// The rest of the address, required or not depending on the country: a
  /// quarter is how an address is given in Cameroon, while Germany needs
  /// street, number and postal code. The rule lives beside the country list,
  /// not here — a column cannot express "required only for CM".
  district     String?
  postal_code  String?
  street       String?
  house_number String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  /// Exam slots bought and not yet spent. One is spent per participant when
  /// a sitting is published; there is no minimum purchase, unlike seats, and
  /// a candidate who does not turn up has still used theirs.
  exam_slots_remaining Int @default(0)

  /// Slots for the 1,500 XAF product, counted apart from the 1,000 one.
  ///
  /// Two columns rather than one with a tier, because they are two prices: a
  /// center holding ten cheap slots must not be able to run ten AI exams,
  /// and a single pool would have to remember what each slot cost.
  exam_ai_slots_remaining Int @default(0)

  users             CenterUser[]
  activation_codes  ActivationCode[]
  exam_sessions     ExamSession[]
  payments          Payment[]
  seats             CenterSeat[]
  students          Student[]
  subscription      CenterSubscription?
  entitlement_pools CenterEntitlementPool[]

  @@map("centers")
}

/// One per center, created with the center so a center without a subscription
/// is a bug rather than a supported state.
///
/// There is no `status` column on purpose. A stored status has to be kept
/// correct by a scheduled job, and when that job runs late the failure
/// direction is granting access nobody paid for. These timestamps are the
/// facts; `SubscriptionPolicyService` derives the status from them on read.
model CenterSubscription {
  id        String     @id @default(uuid())
  center_id String     @unique
  plan      CenterPlan @default(TRIAL)

  /// Set by the first student activation (Phase 4), not at registration.
  trial_started_at DateTime?
  trial_ends_at    DateTime?
  /// Set by verified payment (Phase 7). Grace is derived from it, and applies
  /// only to a lapsed paid period — an expired trial blocks immediately.
  paid_until       DateTime?

  /// The day of the month every period of this centre ends on, 1-31, in
  /// Africa/Douala (D4 rule 9).
  ///
  /// A day rather than a date, because the rule is that the day is remembered
  /// across months that do not have it: 31 January becomes 28 February and
  /// then 31 March again. A stored date would lose that the first time it
  /// landed on a short month.
  ///
  /// Null until the first payment. Captured then because it cannot be
  /// recovered afterwards — the day a school first paid is only knowable on
  /// the day it pays — and because adding seats mid-period must never move
  /// the renewal date.
  anchor_day Int?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  center Center @relation(fields: [center_id], references: [id], onDelete: Cascade)

  @@map("center_subscriptions")
}

/// The seats a center holds.
///
/// One row per center: Start is the only plan (the tiers were removed on
/// 2026-09-23), so a seat count never depends on summing several rows.
/// A chargeable AI operation, one value per thing a quota is counted against.
///
/// An enum rather than free text so a typo cannot silently create a new
/// category that no allowance covers. Only speaking is metered today; Premium's
/// "AI in every module" adds values here, and each new value needs an
/// allowance before it is written.
enum AiOperation {
  SPEAKING_EVALUATION
  /// One conversation with Elena. The unit Start sells — five a month — and
  /// the unit an AI Speaking credit buys.
  ///
  /// A row rather than a counter, so the allowance is derived on read and
  /// there is nothing to reset on a schedule and nothing that can drift from
  /// the sessions it claims to describe.
  SPEAKING_LIVE_SESSION
}

model CenterSeat {
  id        String @id @default(uuid())
  center_id String
  /// Seats held. Never zero: a row saying "no seats" is not the same as no
  /// row, and would make every count ambiguous.
  quantity  Int

  /// The price this center pays per seat, copied in at purchase rather
  /// than looked up. This is what makes grandfathering automatic — raising the
  /// list price later cannot rewrite what a center already agreed to.
  ///
  /// Zero is legal, and is how a free trial seat is held.
  unit_price_xaf Int

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  center Center @relation(fields: [center_id], references: [id], onDelete: Cascade)

  @@unique([center_id])
  @@map("center_seats")
}

/// Where an activation code stands.
///
/// `ACTIVATED` is a code waiting for a student, `CONNECTED` one a student has
/// redeemed, `DEACTIVATED` one the center has taken back. There is no
/// `EXPIRED`: expiry is a date compared on read, so a code cannot sit in the
/// wrong state because no job ran.
enum ActivationCodeStatus {
  ACTIVATED
  CONNECTED
  SUSPENDED
  DEACTIVATED
}

/// One seat, as a value a center can hand to a student.
///
/// Created only by the backend — a trial starting, or a payment succeeding —
/// so the number of codes and the number of seats paid for cannot disagree.
/// There is no route that makes one by hand.
model ActivationCode {
  id        String               @id @default(uuid())
  center_id String
  /// `LQ-XXXX-XXXX`, stored readable rather than hashed: a manager has to see
  /// it again on the Users page to hand it out. Deactivation, not secrecy, is
  /// what protects a seat.
  code      String               @unique
  status    ActivationCodeStatus @default(ACTIVATED)

  /// The student who redeemed it, and what they were called at that moment.
  /// Name and email are copied rather than joined so the center still sees who
  /// held a seat after the student is gone; the id is the link that matters.
  student_id   String?
  linked_name  String?
  linked_email String?
  connected_at DateTime?
  /// Where the redemption came from. A center holds the code and can redeem it
  /// itself, so this is the audit trail that makes that visible afterwards.
  connected_ip String?

  /// When the seat stops working, compared on read. Null means it follows the
  /// center's subscription rather than a date of its own — which is what every
  /// paid code does (D4: all codes of a school end with its pack). Only the
  /// trial code carries a date.
  expires_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  center Center @relation(fields: [center_id], references: [id], onDelete: Cascade)

  events           ActivationCodeEvent[]
  entitlement_caps CodeEntitlementCap[]
  entitlements     CodeEntitlement[]

  /// The Users page lists a center's codes by state; redemption looks one up
  /// by its value, which the unique index above already covers.
  ///
  /// Also enforced, outside this schema: a student holds at most ONE
  /// connected code — a partial unique index on (student_id) where
  /// status = 'CONNECTED', in migration 20260918200000. Prisma cannot express
  /// a partial index; it is what makes two simultaneous redemptions by one
  /// student fail instead of both succeeding.
  @@index([center_id, status])
  @@index([student_id])
  @@map("activation_codes")
}

/// One of the add-ons sold beside Start.
///
/// The same words as the matching `PaymentKind` values, so an invoice line and
/// the row it granted read alike.
enum EntitlementProduct {
  PREP_PASS
  AI_SPEAKING_CREDIT
  AI_ASSISTED_LEARNING
}

/// What a center bought and has not handed out. The money.
///
/// One pot per product rather than one balance with a discount: a center may
/// hold credits and passes at once, and neither may be spent as the other.
/// Buying twice accumulates here — the history of who bought what and when is
/// `payments`, and a second ledger would be a second thing to keep true.
model CenterEntitlementPool {
  center_id String
  product   EntitlementProduct
  /// Never below zero: the check constraint in the migration is the backstop
  /// under the conditional update that spends one, the same way the exam slot
  /// columns are guarded.
  balance   Int                @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  center Center @relation(fields: [center_id], references: [id], onDelete: Cascade)

  @@id([center_id, product])
  @@map("center_entitlement_pools")
}

/// Who may draw on the pool, and how much of it. The permission.
///
/// A ceiling, not a wallet. Credit is never moved onto a seat, so a student who
/// does not use theirs strands nothing: what is left stays in the pool for
/// whoever needs it, and a student two sessions short costs the center one
/// number rather than a second purchase.
///
/// It hangs off the activation code rather than the student because a code
/// exists before anybody holds it — so a center can buy ahead — and because a
/// seat that changes hands should carry what was bought for it (ADR 0002). A
/// student holds at most one connected code, so per-code and per-student are
/// the same number whenever somebody holds it.
model CodeEntitlementCap {
  code_id String
  product EntitlementProduct
  /// Zero by default, and that is the authorization: nobody spends until a
  /// manager says so.
  cap     Int                @default(0)
  /// Counted here rather than from `ai_usage`, because a cap belongs to the
  /// seat and a seat can change hands — counting rows would charge whoever
  /// holds the code now for what the last holder used.
  ///
  /// Deliberately NOT constrained to stay under `cap`: lowering a cap to zero
  /// is how a manager stops somebody mid-term, and their spent sessions are
  /// history rather than a contradiction. `used < cap` is the spend condition,
  /// checked when spending.
  used    Int                @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  code ActivationCode @relation(fields: [code_id], references: [id], onDelete: Cascade)

  @@id([code_id, product])
  @@map("code_entitlement_caps")
}

/// A period granted to one seat: a Prep Pass, a month of AI Assisted Learning.
///
/// It left the pool and does not come back. One row per product per code, so a
/// second pass extends the date rather than opening a parallel one — two live
/// passes on one seat is not a state anything should have to reason about.
model CodeEntitlement {
  code_id    String
  product    EntitlementProduct
  /// Compared on read. There is no `active` column for the reason a
  /// subscription has no `status` one: a stored flag needs a job to keep it
  /// true, and the direction it fails in is granting what nobody paid for.
  expires_at DateTime

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  code ActivationCode @relation(fields: [code_id], references: [id], onDelete: Cascade)

  @@id([code_id, product])
  @@index([product, expires_at])
  @@map("code_entitlements")
}

/// Every change a center makes to one of its codes.
///
/// Append-only. It answers "who cut this student off, and when" after the
/// fact, and it is the count behind any future limit on how often one seat may
/// move between students — without it, a school could rotate one paid seat
/// through a whole class and nothing would show it.
model ActivationCodeEvent {
  id             String               @id @default(uuid())
  code_id        String
  center_id      String
  /// The manager who acted, or null when the system did. Activation moves a
  /// trial student onto a paid code without anybody pressing anything, and
  /// those two events are the only ones with no manager behind them.
  center_user_id String?
  from_status    ActivationCodeStatus
  to_status      ActivationCodeStatus
  /// Who held the seat at that moment, so a deactivation still names the
  /// student it cut off after the code has been handed to someone else.
  student_id     String?
  /// Set on a RESET, and only there: the value the code had before it was
  /// replaced (D39). Filled means "this event is a reset" — the reset limit
  /// counts these rows, never status moves, so a reset cannot be mistaken for
  /// a deactivate-then-activate or missed because the statuses matched.
  previous_code  String?
  created_at     DateTime             @default(now())

  code ActivationCode @relation(fields: [code_id], references: [id], onDelete: Cascade)

  @@index([code_id, created_at])
  @@map("activation_code_events")
}

/// What a payment bought. `total_seats` counts either.
enum PaymentKind {
  SEATS
  EXAM_SLOTS
  /// The 1,500 XAF tier. Its own value rather than a flag beside EXAM_SLOTS,
  /// so an invoice reads back as the product that was actually sold.
  EXAM_SLOTS_AI
  /// The three add-ons. Named identically to `EntitlementProduct`, so an
  /// invoice line and the entitlement it granted say the same word.
  PREP_PASS
  AI_SPEAKING_CREDIT
  AI_ASSISTED_LEARNING
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

/// A center's intent to pay for seats.
///
/// Nothing here grants access. Only a verified provider event may move
/// `paid_until` (Phase 7), which is why `SUCCEEDED` exists in the enum from
/// the start but is never written in this phase — Phase 7 needs somewhere to
/// put a verified result without another migration.
model Payment {
  id        String @id @default(uuid())
  center_id String

  /// What this payment buys. Exam slots ride on the same flow rather than a
  /// second one, so a center has one payment history and one invoice shape.
  kind           PaymentKind @default(SEATS)
  /// How many of whatever `kind` names: seats, exam slots, and whatever the
  /// next center product counts. Called `total_seats` until 2026-09-24, when
  /// it stopped being only seats.
  quantity       Int
  /// The price per seat that applied when the payment was created, which is
  /// what keeps an old invoice truthful after the list price moves.
  unit_price_xaf Int
  /// What the whole payment comes to, snapshotted at creation. A price change
  /// next year must not rewrite what a center agreed to this year, so this is
  /// a copy rather than a join back to today's prices.
  amount_xaf     Int
  /// `amount_xaf` without the VAT, and the VAT on its own. Providers take one
  /// integer and have no tax field, so `amount_xaf` is TTC; an invoice needs
  /// the two lines underneath it, and dividing a rounded total back out does
  /// not reliably return them.
  ///
  /// Null on a row written before VAT was recorded separately. Deliberately not
  /// backfilled: whether such a row's total was HT or TTC cannot be known from
  /// the row, and a guess would put a wrong number on an invoice.
  amount_net_xaf Int?
  vat_amount_xaf Int?

  /// Whether paying this starts a new period, or only adds to one already
  /// paid for.
  ///
  /// Decided when the payment is created, because only then is the clock the
  /// right one to read. A webhook can arrive hours later, after the period has
  /// elapsed, and a center that added two seats on its last day must not be
  /// read as renewing the next morning (D4 rule 3: adding seats never moves
  /// the renewal date).
  ///
  /// True for a first pack and a renewal, false for a mid-period addition.
  /// Defaults true, which is what every row written before this column meant.
  /// Only the seats path reads it; exam slots and entitlements never extend a
  /// period.
  renews_period Boolean @default(true)

  status PaymentStatus @default(PENDING)

  /// The payment provider's own id for this transaction, stored when a
  /// checkout starts. A webhook finds its payment by this, and it is unique so
  /// one provider transaction can never be applied to two payments. Null until
  /// a checkout exists; Postgres allows any number of nulls under a unique
  /// index.
  provider_reference String?   @unique
  /// Where the center is sent to pay, stored with the reference. A repeated or
  /// double-clicked checkout returns this instead of asking the provider
  /// again, which would open a second provider transaction for one payment.
  checkout_url       String?
  /// Which payment method opened the checkout: `notchpay` (Mobile Money) or
  /// `stripe` (card). Null until checkout; webhooks and refunds route by it.
  provider           String?
  /// When activation granted access. Set once, by the same statement that
  /// moves the status, so the two can never disagree.
  succeeded_at       DateTime?
  /// When the provider reported the payment failed. A later success still
  /// activates — the provider is the authority on whether money moved.
  failed_at          DateTime?

  /// Supplied by the client and claimed atomically by the unique index below.
  /// The index is the concurrency control: two simultaneous requests race to
  /// insert, one wins, and the loser is answered from the row that won.
  idempotency_key String
  /// Fingerprint of the request the key was first used with. A replay carrying
  /// the same key but different seats is a different intent wearing the same
  /// name, and is refused rather than handed the original record.
  request_hash    String

  /// What this payment was for, beyond how many: the codes the manager picked
  /// and the cap they chose.
  ///
  /// Nothing may be granted before money moves, and hours can pass between the
  /// purchase and the webhook, so the choice has to survive in between. Read
  /// once, at activation, and re-validated there — a code deactivated in the
  /// meantime has its cap dropped, while the pool is still credited, because
  /// the money moved either way.
  ///
  /// Null for a purchase that needs none: seats, exam slots, a bare top-up.
  metadata Json?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  center Center @relation(fields: [center_id], references: [id], onDelete: Cascade)

  @@unique([center_id, idempotency_key])
  @@index([center_id, created_at])
  @@map("payments")
}

model CenterUser {
  id         String         @id @default(uuid())
  center_id  String
  role       CenterUserRole @default(OWNER)
  first_name String
  last_name  String
  email      String         @unique
  /// The manager's own number, not the school's public line, and collected
  /// during onboarding rather than at registration. Nullable for that reason.
  /// This is who gets contacted about a late payment or a locked account.
  phone      String?

  /// Where the manager is, which is not necessarily where the school is — a
  /// chain's owner may sit in Yaoundé while the school is in Douala. Same
  /// three columns as the center, and the same rule: the region is derived
  /// from the city, never sent by a client. No address fields: nothing is
  /// posted to a manager.
  country_code String?
  region_id    String?
  city_id      String?
  city_other   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt
  last_seen_at DateTime @default(now())

  password_hash              String
  email_verified             Boolean   @default(false)
  email_verification_token   String?
  email_verification_expires DateTime?
  password_reset_token       String?
  password_reset_expires     DateTime?

  center          Center                @relation(fields: [center_id], references: [id], onDelete: Restrict)
  device_sessions CenterDeviceSession[]

  @@index([center_id])
  @@index([email_verification_token])
  @@index([password_reset_token])
  @@map("center_users")
}

model CenterDeviceSession {
  id                 String    @id @default(uuid())
  center_user_id     String
  device_id          String
  refresh_token_hash String
  device_name        String?
  last_used_at       DateTime  @default(now())
  created_at         DateTime  @default(now())
  revoked_at         DateTime?

  center_user CenterUser @relation(fields: [center_user_id], references: [id], onDelete: Cascade)

  @@unique([center_user_id, device_id])
  @@index([center_user_id])
  @@map("center_device_sessions")
}

model WritingAttempt {
  attempt_id        String    @id @default(uuid())
  student_id        String
  exercise_id       String
  modelltest_id     String?   @db.Uuid
  content           String
  status            String    @default("pending")
  score             Int?
  feedback          String?
  corrected_text    String?
  corrections       Json?
  diff              Json?
  points_addressed  Int?
  /// telc Deutsch B1 Schriftlicher Ausdruck: letters + /45 points.
  /// Shape: { taskFulfilment, communicativeDesign, formalAccuracy, points }.
  telc_rating       Json?
  duration_seconds  Int?
  notification_sent Boolean   @default(false)
  created_at        DateTime  @default(now())
  completed_at      DateTime?

  /// Set when this attempt was made inside an exam sitting, null for
  /// ordinary training. Every training read filters on it being null, so exam
  /// work never appears in a student's own history or in their readiness.
  exam_attempt_id String?

  /// Set when a code reset hid this row for erasure (D39); null = visible.
  erasure_id String?

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@index([erasure_id])
  @@map("writing_attempts")
}

model ListeningAttempt {
  attempt_id       String    @id @default(uuid())
  student_id       String
  exercise_id      String
  status           String    @default("completed")
  score            Int?
  feedback         String?
  duration_seconds Int?
  content_revision String?
  timed            Boolean?
  created_at       DateTime  @default(now())
  completed_at     DateTime?

  /// What the candidate chose, per question.
  ///
  /// Training never stored this — a Hören score was all anyone wanted. An
  /// exam result gets disputed, and "we have the score but not the answers"
  /// is not something a center can take back to a candidate. Nullable, so
  /// every training row written before this stays as it was.
  answers Json?

  // Nullable on purpose: Hoeren content is not yet in the database, so an
  // attempt whose content_revision names no Modelltest (e.g. the historic
  // mock-horen-* rows) genuinely belongs to no exam.
  modelltest_id         String?            @db.Uuid
  listening_exercise_id String?            @db.Uuid
  listening_exercise    ListeningExercise? @relation(fields: [listening_exercise_id], references: [id], onDelete: Restrict)

  /// Set when this attempt was made inside an exam sitting, null for
  /// ordinary training. Every training read filters on it being null, so exam
  /// work never appears in a student's own history or in their readiness.
  exam_attempt_id String?

  /// Set when a code reset hid this row for erasure (D39); null = visible.
  erasure_id String?

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@index([listening_exercise_id])
  @@index([erasure_id])
  @@map("listening_attempts")
}

model SprachbausteineAttempt {
  attempt_id         String    @id @default(uuid())
  student_id         String
  teil_id            String
  modelltest_id      String?
  status             String    @default("completed")
  score              Int?
  feedback           String?
  answers            Json?
  content_revision   String?
  duration_seconds   Int?
  // True for every attempt taken after the answer key started shipping with
  // GET /exercise. Without it, no later analysis can tell which attempts were
  // made with the answers already on the device.
  answers_prefetched Boolean   @default(true)
  created_at         DateTime  @default(now())
  completed_at       DateTime?

  /// Set when this attempt was made inside an exam sitting, null for
  /// ordinary training. Every training read filters on it being null, so exam
  /// work never appears in a student's own history or in their readiness.
  exam_attempt_id String?

  /// Set when a code reset hid this row for erasure (D39); null = visible.
  erasure_id String?

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id, teil_id])
  @@index([erasure_id])
  @@map("sprachbausteine_attempts")
}

