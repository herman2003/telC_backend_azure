model LesenTeil3Exercise {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentRevision String
  label           String
  instruction     String
  createdAt       DateTime @default(now())

  situations    LesenTeil3Situation[]
  announcements LesenTeil3Announcement[]

  modelltest_id String     @db.Uuid
  modelltest    Modelltest @relation(fields: [modelltest_id], references: [id])

  @@unique([modelltest_id])
  @@map("lesen_teil3_exercises")
}

model LesenTeil3Announcement {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId String @db.Uuid
  title      String
  content    String
  sortOrder  Int

  exercise   LesenTeil3Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  situations LesenTeil3Situation[]

  @@map("lesen_teil3_announcements")
}

model LesenTeil3Situation {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId            String  @db.Uuid
  situationNumber       Int
  content               String
  noMatch               Boolean @default(false)
  correctAnnouncementId String? @db.Uuid
  sortOrder             Int

  exercise            LesenTeil3Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  correctAnnouncement LesenTeil3Announcement? @relation(fields: [correctAnnouncementId], references: [id], onDelete: Restrict)

  @@map("lesen_teil3_situations")
}

model Modelltest {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number Int    @unique
  title  String

  // timestamptz(6), not Prisma's default timestamp(3): this table was created
  // by a hand-written SQL migration (007) that used TIMESTAMPTZ. Declared here
  // so the schema describes the database rather than drifting from it.
  created_at DateTime @default(now()) @db.Timestamptz(6)

  sprachbausteineExercises      SprachbausteineExercise[]
  sprachbausteineTeil2Exercises SprachbausteineTeil2Exercise[]
  lesenTeil1Exercises           LesenTeil1Exercise[]
  lesenTeil2Exercises           LesenTeil2Exercise[]
  lesenTeil3Exercises           LesenTeil3Exercise[]
  writingExercises              WritingExercise[]
  listeningExercises            ListeningExercise[]
  speakingExercises             SpeakingExercise[]
  examSessions                  ExamSession[]

  /// Kept out of the training catalogue, so an exam sitting can use material
  /// no student has seen. False for everything that exists today.
  exam_only Boolean @default(false)

  @@map("modelltests")
}

model ListeningExercise {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modelltest_id       String   @db.Uuid
  part                Int
  title               String
  subtitle            String?
  instruction         String
  content_revision    String   @unique
  duration_minutes    Int
  audio_url           String   @default("")
  bundled_audio_asset String   @default("")
  image_url           String
  transcript          String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  modelltest Modelltest          @relation(fields: [modelltest_id], references: [id], onDelete: Restrict)
  questions  ListeningQuestion[]
  attempts   ListeningAttempt[]

  @@unique([modelltest_id, part])
  @@index([modelltest_id])
  @@map("listening_exercises")
}

model ListeningQuestion {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercise_id     String @db.Uuid
  question_number Int
  prompt          String
  correct_answer  String
  sort_order      Int

  exercise ListeningExercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade)

  @@unique([exercise_id, question_number])
  @@unique([exercise_id, sort_order])
  @@index([exercise_id])
  @@map("listening_questions")
}

model SpeakingExercise {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modelltest_id         String   @db.Uuid
  part                  Int
  title                 String
  subtitle              String?
  topic_title           String
  topic_description     String
  topic_points          Json
  instructions          String
  duration_minutes      Int
  prep_duration_seconds Int
  image_url             String
  exam_image_url        String?
  content_revision      String   @unique
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  modelltest Modelltest @relation(fields: [modelltest_id], references: [id], onDelete: Restrict)

  @@unique([modelltest_id, part])
  @@index([modelltest_id])
  @@map("speaking_exercises")
}

model WritingExercise {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content_revision  String
  title             String
  subtitle          String?
  task_type         String
  intro             String?
  stimulus          Json?
  task_instructions String
  bullet_points     String[] @default([])
  closing_reminder  String?
  // See Modelltest.created_at — same hand-written-migration origin.
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  modelltest_id String     @db.Uuid
  modelltest    Modelltest @relation(fields: [modelltest_id], references: [id])

  @@unique([modelltest_id])
  @@map("writing_exercises")
}

/// One row per successful chargeable AI operation.
///
/// Written after the AI returns something usable, never when the student
/// presses start: the alternative charges a student for our own outage, and a
/// bad afternoon on our side would cost a Start student their whole day.
/// Metered APIs do not bill a 500, and neither does this.
///
/// The rows are the quota. Nothing is stored per student and nothing resets on
/// a schedule — the allowance is "how many of these are newer than 24 hours
/// ago", which is why there is no counter here to drift from the rows it
/// claims to describe. They double as the measurement of whether the
/// allowances are set right, which arrives as a side effect of enforcing them.
model AiUsage {
  id         String      @id @default(uuid())
  student_id String
  operation  AiOperation
  created_at DateTime    @default(now())

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  /// Exactly the quota question: this student, this operation, newer than a
  /// timestamp. Column order matters — student first because it is the
  /// equality, created_at second because it is the range.
  @@index([student_id, operation, created_at])
  @@map("ai_usage")
}

/// A CEFR level, as far as this product goes (D38).
enum CefrLevel {
  A1
  A2
  B1
  B2
}

/// The five skills of the telc B1 exam, as a student practises them.
enum Skill {
  HOEREN
  LESEN
  SPRACHBAUSTEINE
  SCHREIBEN
  SPRECHEN
}

/// One row per completed attempt, the same shape for every skill (D26).
///
/// What the dashboard, the app's history and its home screen read. The
/// detailed attempt stays in its own table; this is the summary, written in
/// the same transaction so neither can exist without the other.
///
/// A Writing attempt lands here when its correction finishes with a real
/// score, not at submit: until then there is nothing to summarise.
model StudentActivity {
  id               String   @id @default(uuid())
  student_id       String
  skill            Skill
  teil             Int
  score            Int
  /// Carried rather than assumed, so a skill scored on another scale later
  /// never needs every reader to know it. 100 for every skill today.
  max_score        Int
  duration_seconds Int?
  /// Null when the attempt belongs to no Modelltest (historic listening rows).
  modelltest_id    String?  @db.Uuid
  /// The detailed row, in the table the skill names.
  attempt_id       String
  /// When the attempt was completed.
  created_at       DateTime @default(now())

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  /// Set when a code reset hid this row for erasure (D39); null = visible.
  erasure_id String?

  @@unique([skill, attempt_id])
  @@index([student_id, created_at])
  @@index([student_id, skill, created_at])
  @@index([erasure_id])
  @@map("student_activities")
}

/// A scored Lesen Teil. Lesen stored nothing before phase 11.
model LesenAttempt {
  attempt_id       String   @id @default(uuid())
  student_id       String
  teil_id          String
  modelltest_id    String   @db.Uuid
  score            Int
  answers          Json
  duration_seconds Int?
  created_at       DateTime @default(now())

  /// Set when this attempt was made inside an exam sitting, null for
  /// ordinary training. Every training read filters on it being null, so exam
  /// work never appears in a student's own history or in their readiness.
  exam_attempt_id String?

  /// Set when a code reset hid this row for erasure (D39); null = visible.
  erasure_id String?

  @@index([student_id, teil_id])
  @@index([erasure_id])
  @@map("lesen_attempts")
}

/// An evaluated speaking transcript. `evaluate` stored nothing before phase 11.
model SpeakingAttempt {
  attempt_id       String   @id @default(uuid())
  student_id       String
  teil_number      Int
  /// Null only for rows stored before the column existed.
  modelltest_id    String?  @db.Uuid
  transcript       String
  score            Int
  /// The evaluation as returned to the student: sub-scores, text, corrections.
  evaluation       Json
  duration_seconds Int?
  created_at       DateTime @default(now())

  /// Set when a code reset hid this row for erasure (D39); null = visible.
  erasure_id String?

  @@index([student_id, teil_number])
  @@index([erasure_id])
  @@map("speaking_attempts")
}

/// A reset took this seat from a student; their learning data on it is
/// hidden now and erased once `erase_after` passes (D39). Until then support
/// can restore it. The rows it covers carry its id in `erasure_id`.
model DataErasure {
  id             String    @id @default(uuid())
  student_id     String
  center_id      String
  code_id        String
  center_user_id String?
  /// The window of the student's time on the seat: what is erased.
  since          DateTime
  until          DateTime
  created_at     DateTime  @default(now())
  erase_after    DateTime
  erased_at      DateTime?
  restored_at    DateTime?

  @@index([erase_after])
  @@index([student_id])
  @@map("data_erasures")
}

enum SupportRequestKind {
  CONTACT
  ACCOUNT_DELETION
}

/// A message from a center to the Lerniqo team (D24), or its request to have
/// the account deleted (D37). Stored before it is emailed, so a mail failure
/// loses nothing: `emailed_at` stays null and the row can be found.
model SupportRequest {
  id             String             @id @default(uuid())
  kind           SupportRequestKind
  center_id      String
  center_user_id String
  /// As typed in the form; the trusted identity is the two ids above.
  name           String
  email          String
  message        String?
  created_at     DateTime           @default(now())
  emailed_at     DateTime?

  @@index([center_id, kind, created_at])
  @@map("support_requests")
}

/// What a center bought for a sitting, fixed when it publishes.
///
/// MANUAL is the 1,000 XAF product: the trainer scores Schreiben, and the
/// Sprechen that happened in the center. AI is 1,500 and adds the machine's
/// proposal on both, which the trainer still confirms or overrides — a second
/// opinion, never the verdict. Stamped on the session rather than read from
/// the center, or a price change would silently re-grade exams a center has
/// already paid for.
enum ExamGradingTier {
  MANUAL
  AI
}

/// One timed block of a telc exam, as telc runs it.
///
/// Lesen and Sprachbausteine share ONE 90-minute block with free navigation
/// between their five Teile — the mistake a per-Teil timer would make.
/// Sprechen is absent on purpose: it happens in the center, in person, and
/// reaches Lerniqo as a score somebody types in.
enum ExamBlock {
  LESEN_SPRACHBAUSTEINE
  HOEREN
  SCHREIBEN
}

/// How long a block lasts, per level, as telc specifies it.
///
/// Data rather than constants, because A2 and B2 are the same product with
/// different numbers: adding them is a seed, not a deployment. Nothing lets a
/// center edit these — a duration a center can change is not an exam.
model ExamBlockDuration {
  id       String    @id @default(uuid())
  level    CefrLevel
  block    ExamBlock
  minutes  Int
  /// The order a candidate sits them in, low first.
  position Int

  @@unique([level, block])
  @@map("exam_block_durations")
}

/// A center's exam sitting: one Modelltest, a named list of candidates, and a
/// window in which they may start.
///
/// There is no `status` column, for the reason `CenterSubscription` has none.
/// A stored status needs a job to keep it true, and the direction it fails in
/// is letting a closed exam be taken. These timestamps are the facts; the
/// status is derived from them on read.
model ExamSession {
  id        String @id @default(uuid())
  center_id String

  /// The center's own wording — "Examen séquentiel B1 — Octobre". Lerniqo
  /// imposes no taxonomy of exam types; the name carries that meaning.
  name          String
  level         CefrLevel
  modelltest_id String          @db.Uuid
  grading_tier  ExamGradingTier @default(MANUAL)

  /// When candidates may begin. Enforced server-side: a published sitting is
  /// not an open one.
  opens_at  DateTime
  /// Computed from the access window the center chose (24h, 48h, 72h), and
  /// editable afterwards: a center may close its own exam early or reopen it
  /// once the window has lapsed.
  closes_at DateTime

  /// Null while the sitting is a draft. Publishing is what spends slots, so
  /// this is set once and never cleared.
  published_at    DateTime?
  cancelled_at    DateTime?
  /// Set when the center closed the sitting by hand, before `closes_at`.
  force_closed_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  center       Center                   @relation(fields: [center_id], references: [id], onDelete: Cascade)
  modelltest   Modelltest               @relation(fields: [modelltest_id], references: [id], onDelete: Restrict)
  participants ExamSessionParticipant[]
  attempts     ExamAttempt[]

  @@index([center_id, opens_at])
  @@map("exam_sessions")
}

/// A student a center admitted to one sitting.
///
/// This row IS the access rule. Holding a Lerniqo account, or even a seat at
/// the center running the exam, grants nothing here: only a row in this table
/// opens that sitting to that student.
model ExamSessionParticipant {
  id         String @id @default(uuid())
  session_id String
  student_id String

  created_at DateTime @default(now())

  session ExamSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([session_id, student_id])
  @@index([student_id])
  @@map("exam_session_participants")
}

/// One candidate's sitting of one exam.
///
/// Unique per student and session: a second start returns the first attempt
/// rather than making a new one, because an exam you can restart is not an
/// exam.
model ExamAttempt {
  id         String @id @default(uuid())
  session_id String
  student_id String

  started_at   DateTime  @default(now())
  /// Set when the last block is submitted. Null while the candidate is still
  /// somewhere in the exam.
  submitted_at DateTime?

  session ExamSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [student_id], references: [id], onDelete: Cascade)

  blocks ExamAttemptBlock[]
  plays  ExamAudioPlay[]

  @@unique([session_id, student_id])
  @@index([student_id])
  @@map("exam_attempts")
}

/// One timed block of one attempt.
///
/// `deadline_at` is an instant, written when the block starts and never
/// moved. A refresh, a second device, a killed app and a wrong phone clock
/// all read the same answer from it; a stored "seconds remaining" would
/// answer each of them differently.
model ExamAttemptBlock {
  id         String    @id @default(uuid())
  attempt_id String
  block      ExamBlock

  started_at   DateTime  @default(now())
  deadline_at  DateTime
  submitted_at DateTime?

  attempt ExamAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)

  @@unique([attempt_id, block])
  @@map("exam_attempt_blocks")
}

/// How often a candidate has played one Hören recording.
///
/// telc allows one play in Teil 1 and two in Teils 2 and 3, and the count
/// lives here rather than in the client because hiding a button is not a
/// rule. A play is spent when it starts: a connection dropping at 0:15 costs
/// it, exactly as the recording would keep playing in the room.
model ExamAudioPlay {
  id         String @id @default(uuid())
  attempt_id String
  /// The `listening_exercises` row this counts plays of.
  audio_id   String @db.Uuid

  plays_used Int @default(0)

  attempt ExamAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)

  @@unique([attempt_id, audio_id])
  @@map("exam_audio_plays")
}
